# ─────────────────────────────────────────────────────────────
# Kidzlim store — environment for a VPS (CloudPanel Node.js site)
# Save as /home/<site-user>/kidzlim.env (OUTSIDE htdocs), then: chmod 600 ~/kidzlim.env
# Example values are for site user "webi-kidzlim" and kidzlim.webimation.io.
# ─────────────────────────────────────────────────────────────

# Must match the "App Port" shown for the Node.js site in CloudPanel.
APP_PORT=3000

NEXT_PUBLIC_SERVER_URL=https://kidzlim.webimation.io

# Persistent data, outside the project folder (survives redeploys).
DATABASE_URL=file:/home/webi-kidzlim/kidzlim-data/kidzlim.db
MEDIA_DIR=/home/webi-kidzlim/kidzlim-data/media
PROTECTED_MEDIA_DIR=/home/webi-kidzlim/kidzlim-data/protected-media
BACKUP_KEEP_DAYS=14

# Generate each with:  openssl rand -hex 32   (CREDENTIALS_ENCRYPTION_KEY: openssl rand -base64 32)
# Keep a copy in a password manager.
PAYLOAD_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
CRON_SECRET=

# CloudPanel's Nginx is the only proxy in front of the app. Set 2 if you add Cloudflare.
TRUSTED_PROXY_HOPS=1

# API keys (Stripe, Gelato, Brevo) are entered in the admin → Store Settings.
