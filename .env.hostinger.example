# ─────────────────────────────────────────────────────────────
# Kidzlim store — environment for Hostinger Node.js hosting (Business / Cloud plans)
# Import this in hPanel → your Node.js app → Environment variables (after filling it in).
# Replace u123456789 with your Hostinger username (shown in File Manager as /home/u123456789)
# and kidzlim.com with your domain. Do NOT set NODE_ENV here.
# ─────────────────────────────────────────────────────────────

# Persistent data folder — OUTSIDE domains/…/hbuilds and public_html, which are replaced on every deploy.
DATABASE_URL=file:/home/u123456789/kidzlim-data/kidzlim.db
MEDIA_DIR=/home/u123456789/kidzlim-data/media
PROTECTED_MEDIA_DIR=/home/u123456789/kidzlim-data/protected-media
# Daily database snapshots (made by the cron call below). Defaults to kidzlim-data/backups.
BACKUP_KEEP_DAYS=14

NEXT_PUBLIC_SERVER_URL=https://kidzlim.com

# Generate each on your PC and keep a copy in a password manager:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      → PAYLOAD_SECRET, CRON_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   → CREDENTIALS_ENCRYPTION_KEY
PAYLOAD_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
# Used by the hPanel cron job that wakes the app to run fulfilment jobs and backups.
CRON_SECRET=

# API keys (Stripe, Gelato, Brevo) are entered in the admin → Store Settings, not here.
