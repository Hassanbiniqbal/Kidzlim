# ─────────────────────────────────────────────────────────────
# Kidzlim store — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------
# SQLite (local dev, Hostinger Node.js hosting): file:./data/kidzlim.db  — see HOSTINGER.md
# PostgreSQL (Docker/VPS): postgres://user:pass@127.0.0.1:5432/kidzlim — docker-compose overrides it.
DATABASE_URL=file:./data/kidzlim.db
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Upload storage. Docker mounts a volume at /app/media.
MEDIA_DIR=./media
# Paid PDFs (print + digital). Must NOT be web-served. Docker mounts a separate volume.
PROTECTED_MEDIA_DIR=./protected-media

# --- Docker Compose (VPS) -----------------------------------
POSTGRES_USER=kidzlim
POSTGRES_PASSWORD=
POSTGRES_DB=kidzlim

# Nightly backups (docker compose `backup` service). Time is UTC.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14

APP_PORT=3000

# --- Credential encryption (brief §6) ----------------------
# REQUIRED to save API keys in Store Settings. 32-byte key, base64. Lives ONLY in the server env,
# never in the DB. Losing it means re-entering the keys in Store Settings. Back it up separately.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# Rotation: put the old key here, the new one above, then re-save Store Settings once.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# --- Integration fallbacks ----------------------------------
# Runtime order: encrypted value in admin Settings → these env vars → loud failure.
# Stripe
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gelato
GELATO_API_KEY=
GELATO_WEBHOOK_SECRET=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_NAME=Kidzlim
BREVO_SENDER_EMAIL=
BREVO_TEMPLATE_ORDER_CONFIRMATION=
BREVO_TEMPLATE_DIGITAL_DELIVERY=
BREVO_TEMPLATE_SHIPPING_NOTIFICATION=
BREVO_TEMPLATE_DOWNLOAD_RESEND=

# --- Store defaults (overridable in admin Settings) ---------
STORE_SUPPORT_EMAIL=
STORE_SHIPPING_COUNTRIES=AE
DOWNLOAD_EXPIRY_HOURS=48
MAX_DOWNLOADS_PER_ORDER=5

# --- Development only ---------------------------------------
# Fake Gelato shipping quotes so checkout can be tested without a Gelato key.
# Ignored when NODE_ENV=production.
GELATO_MOCK=0
# Print emails to the server log instead of sending them via Brevo.
BREVO_MOCK=0

# --- Background jobs ----------------------------------------
# Fulfilment jobs run every minute in the app process. Set to 0 to disable (e.g. on a second replica).
JOBS_AUTORUN=1
